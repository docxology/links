# Required for LLM and image API calls
OPENAI_API_KEY=your_openai_api_key_here

# Optional — see src/utils/config.py
# LOG_LEVEL=INFO
# MAX_LINKS=40
# GPT_MODEL=gpt-4
# TIMEOUT=30
# IMAGE_MODEL=gpt-image-1   # defined in config.py; generate_images.py currently hardcodes gpt-image-1
# ESSAY_IMAGE_MODEL=dall-e-3

# Note: HTTP timeout is read from env var TIMEOUT (not REQUEST_TIMEOUT).
# MAX_CONCURRENT_REQUESTS is currently fixed to 5 in code.
